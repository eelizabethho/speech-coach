# Required — get one at https://console.anthropic.com (Settings → API keys)
ANTHROPIC_API_KEY=

# Optional — more natural "cloud voice" via Google Cloud Text-to-Speech.
# Enable the Text-to-Speech API in a Google Cloud project and create an API key.
GOOGLE_TTS_API_KEY=
# Optional voice name, see https://cloud.google.com/text-to-speech/docs/voices
GOOGLE_TTS_VOICE=en-US-Neural2-F

# Optional — "Gemini Live" interviewer engine (real-time speech-to-speech).
# Create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional model override (default gemini-3.8-live)
GEMINI_LIVE_MODEL=
